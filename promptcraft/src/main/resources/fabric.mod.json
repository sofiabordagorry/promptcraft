{
	"schemaVersion": 1,
	"id": "promptcraft",
	"version": "${version}",
	"name": "Promptcraft",
	"description": "A Fabric mod that integrates Minecraft with a Large Language Model. Use /askAI to describe a structure and receive a special block that generates it in the world.",
	"authors": [
		"Sofía Bordagorry"
	],
	"contact": {
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/promptcraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.ExampleMod"
		]
	},
	"mixins": [
		"promptcraft.mixins.json",
		{
			"config": "promptcraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}